	"authors": [
		"E4rth3n"
	],
	"contact": {
		"homepage": "https://discord.gg/mrXBHH2np5",
		"sources": "https://github.com/earthen-r4x/minecraft-hardcore-fabric26.2"
	},
	"license": "GPL-v3",
	"icon": "assets/igoo/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.igoo.Igoo"
		],
		"client": [
			"com.igoo.client.IgooClient"
		],
		"fabric-datagen": [
			"com.igoo.client.IgooDataGenerator"
		],
                "terrablender": [
                        "com.igoo.worldgen.ModTerraBlenderAPI"
                ]
	},
	"mixins": [
